# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ml artifacts (do NOT commit)
*.safetensors
*.ckpt
*.bin
*.pt
*.pth

# ...but Build Mode's 3D assets are committed on purpose, so a fresh clone --
# and the defense machine with no network -- still renders the room. They ship
# as self-contained .glb (no sibling .bin: download managers and ad-blocker
# filter lists intercept that extension). Kept as a guard in case a future
# asset arrives as .gltf + .bin, where the blanket rule above would silently
# drop the vertex data and the model would load to an empty scene.
!public/models/**/*.bin

# generated outputs
outputs/finals/*
outputs/sweeps/*
outputs/ablations/*
outputs/baselines/decor8/*
outputs/baselines/roomgpt/*
outputs/baselines/ours/*
!outputs/**/.gitkeep

# datasets (raw images live outside git; only READMEs + templates are tracked)
datasets/*/images/
datasets/*/captions.jsonl

# eval results (regeneratable)
eval/results.csv

# uploads / job outputs from the running backend
backend/uploads/*
!backend/uploads/.gitkeep

# render audit trail (runtime data, metadata-only JSONL)
backend/audit.jsonl

# misc
*.log
.DS_Store
Thumbs.db

# claude code MCP server configs (local, per-developer)
.mcp.json

# Defense-Mode demo pack — generated by scripts/make_demo_pack.py (~40 MB)
/public/demo/

# Furniture assets: the 15 chosen cut-outs ARE tracked (the app needs them), but
# the raw 1024x1024 renders (~43 MB) and the unchosen _v variants are not —
# both are regenerable with scripts/generate_furniture_assets.py.
/assets/furniture_raw/
/public/furniture/*/*_v*.png

# accounts + saved designs (local runtime data, never committed)
backend/dardesign.db
backend/dardesign.db-wal
backend/dardesign.db-shm
/images/old/
/images/new/

# session signing key, generated by scripts/run-local-backend.ps1
.dardesign-secret

# SMTP settings for the subscription decision emails — holds an app password
.dardesign-smtp

# Design Planner credentials — holds an Anthropic API key
.dardesign-llm

# Promo/demo video renders and their source clips. Nothing in the app loads
# these; they are ~14 MB each, which is 8x the largest tracked file, and git
# keeps every version forever. Keep them on disk or in Drive, not in history.
*.mp4
*.mov

# throwaway databases and corpora from scripts/seed_eval_demo.py
.tmp/

# The Gemini pack ships as a folder; the zip is just that folder compressed, so
# committing both stores every future revision of the same bytes twice — once as
# diffable text and once as an opaque binary blob. Rebuild it from the folder.
DAR_GEMINI_ARCHITECTURE_PACK.zip

# …and the pack unzipped into itself at some point, leaving an exact copy of the
# pack inside the pack. It is an accident of extraction, not content.
DAR_GEMINI_ARCHITECTURE_PACK/DAR_GEMINI_ARCHITECTURE_PACK/
